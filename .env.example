# Kais — variáveis de ambiente (copie para .env e preencha).
# NUNCA versione o .env real. Segredos ficam só no servidor.

# Postgres persistente (Railway). Ex.: postgresql://user:pass@host:5432/kais
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/kais?schema=public"

# Fuso e locale padrão da loja (configurável na UI)
TZ="America/Sao_Paulo"

# Segredo de sessão/JWT — gere um valor forte e único por ambiente
AUTH_SECRET="troque-por-um-segredo-forte"

# Armazenamento persistente de uploads (logo, fotos) — NÃO usar /tmp do deploy.
# Ex.: bucket S3-compatível (Railway volume, Cloudflare R2, etc.)
UPLOADS_BUCKET_URL=""
UPLOADS_ACCESS_KEY=""
UPLOADS_SECRET_KEY=""

# Segredo do cron (Vercel injeta como Authorization: Bearer $CRON_SECRET)
CRON_SECRET="troque-por-um-segredo-de-cron"
